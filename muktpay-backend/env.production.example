# MuktPay backend: PRODUCTION environment variables.
# Set these in your hosting provider's dashboard (never commit real values).
# The API refuses to start if any of them is missing or unsafe, so every "change-me" below
# must be replaced.

NODE_ENV=production

# Most hosts set PORT for you. Leave HOST alone inside a container.
# PORT=4000
# HOST=0.0.0.0

# Number of reverse proxies in front of the API. Render, Railway, Fly, nginx, an AWS load
# balancer: 1. Never "true".
TRUST_PROXY=1

# The mobile app does not use CORS. Leave empty unless you add a web app (exact https:// origins).
CORS_ORIGINS=

# ---- PostgreSQL (managed database, version 13 or newer) ----
DB_HOST=change-me-database-host
DB_PORT=5432
DB_USER=change-me-database-user
DB_PASSWORD=change-me-strong-database-password-12plus-chars
DB_NAME=change-me-database-name
# Managed databases require TLS.
DB_SSL=true
# Only if your provider uses a self-signed certificate:
# DB_SSL_REJECT_UNAUTHORIZED=false
# Applies pending migrations when the API starts. Fine for ONE instance; if you ever run
# several, set this to false and run migrations as a separate step.
DB_MIGRATIONS_RUN=true

# ---- JWT: two DIFFERENT random secrets, 32+ characters each ----
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-generate-a-random-secret
JWT_REFRESH_SECRET=change-me-generate-a-different-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Email: REQUIRED in production (verification and password-reset codes are emailed) ----
# Any SMTP provider works. A Mailtrap SANDBOX never delivers, so the API refuses it here.
# The sender address must be one your provider has verified (usually your own domain).
# Enter values WITHOUT quotes in your host's dashboard.
MAIL_HOST=change-me-smtp-host
MAIL_PORT=587
# true only for port 465
MAIL_SECURE=false
MAIL_USER=change-me-smtp-username
MAIL_PASSWORD=change-me-smtp-password
MAIL_FROM=MuktPay <no-reply@change-me-your-domain.com>
