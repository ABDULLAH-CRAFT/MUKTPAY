# Server
PORT=4000
# development | test | production  (required; the API refuses to start without a valid value)
NODE_ENV=development
# Interface to listen on. 0.0.0.0 = reachable from other devices (Expo Go on your phone, Docker).
# Use 127.0.0.1 if a reverse proxy on the same machine is the only thing that should connect.
# HOST=0.0.0.0
# How many reverse proxies sit in front of the API (nginx, Render, Railway, an AWS ALB = 1).
# Needed so rate limiting and stored IPs see the REAL client instead of the proxy.
# Leave unset when the API is exposed directly. Never "true" in production.
# TRUST_PROXY=1
# Comma-separated list of allowed browser origins (web app). Mobile apps don't need CORS.
# In production: exact https:// origins only, no "*", no localhost.
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=muktpay
DB_PASSWORD=muktpay_dev_password
DB_NAME=muktpay
# Remote/managed database: set DB_SSL=true (required to be set explicitly in production).
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false   # only for providers with self-signed certificates
# Apply pending migrations automatically when the API starts.
DB_MIGRATIONS_RUN=true

# JWT: generate two DIFFERENT random secrets:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-dev-only
JWT_REFRESH_SECRET=change-me-refresh-secret-dev-only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Split engine (optional: these are the defaults). Amounts are in PAISE (₹1 = 100).
# SPLIT_MAX_TRANCHE_PAISE=199900
# SPLIT_MIN_TRANCHE_PAISE=100
# SPLIT_MAX_TRANCHES=20