{
  "expo": {
    "name": "MuktPay",
    "slug": "muktpay-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "muktpay",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.muktpay.app",
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "upi",
          "phonepe",
          "gpay",
          "tez",
          "paytmmp"
        ]
      }
    },
    "android": {
      "package": "com.muktpay.app",
      "adaptiveIcon": {
        "backgroundColor": "#1F5EFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F5EFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MuktPay uses the camera to scan UPI QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "MuktPay does not read your photos.",
          "savePhotosPermission": "MuktPay saves the payment QR image to your photos when you tap Download QR.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}